# Copia este archivo como .env y cambia los valores
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos PostgreSQL
DATABASE_URL=postgres://academico:academico123@localhost:5432/academico
DB_POOL_MAX=10

# Tokens (genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SAMESITE=lax

# CORS: orígenes permitidos separados por coma (tu frontend)
CORS_ORIGINS=http://localhost:5173

# Detrás de un proxy (Nginx, Render, Railway...) pon 1
TRUST_PROXY=0

# Usuario administrador inicial (solo para el seed)
SEED_ADMIN_EMAIL=admin@academico.test
SEED_ADMIN_PASSWORD=Admin123!Seguro
